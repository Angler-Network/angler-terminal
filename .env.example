# Angler News API. Both values are read on the server only; never prefix them with NEXT_PUBLIC_.
ANGLER_API_URL=https://api.angler.network
ANGLER_API_KEY=your-angler-api-key

# Optional: override the realtime endpoint (defaults to the production one).
ANGLER_WS_URL=wss://ws.angler.network/connection/websocket

# Hyperliquid venue (public: these reach the browser). Switch networks with config only.
# testnet → https://api.hyperliquid-testnet.xyz, mainnet → https://api.hyperliquid.xyz
NEXT_PUBLIC_HL_NETWORK=testnet
# Builder address that receives the builder fee on every order (required to trade).
NEXT_PUBLIC_HL_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Fee charged per order, in tenths of a basis point (10 = 1 bp = 0.01%). Perps allow at most 100.
NEXT_PUBLIC_HL_BUILDER_FEE=10
# Max fee users approve once during setup, same unit. Must be >= NEXT_PUBLIC_HL_BUILDER_FEE.
NEXT_PUBLIC_HL_MAX_BUILDER_FEE=10
