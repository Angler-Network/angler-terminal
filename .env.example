# Which site this build is: "mainnet" (trade.angler.network) or "testnet" (testnet-trade.angler.network).
# Pins every venue's network and hides the per-browser network switches. Testnet turns off Jupiter and Titan;
# mainnet only offers venues whose settings below are filled in (HL builder address, Jupiter/Titan/Arcus keys).
# Leave empty to set each venue's network below instead.
NEXT_PUBLIC_DEPLOYMENT=
# The other site's URL, linked from the top bar and Settings (e.g. https://testnet-trade.angler.network).
NEXT_PUBLIC_OTHER_DEPLOYMENT_URL=

# Angler News API. Both values are read on the server only; never prefix them with NEXT_PUBLIC_.
ANGLER_API_URL=https://api.angler.network
ANGLER_API_KEY=your-angler-api-key

# Optional: override the realtime endpoint (defaults to the production one).
ANGLER_WS_URL=wss://ws.angler.network/connection/websocket

# Hyperliquid venue (public: these reach the browser). Switch networks with config only.
# testnet → https://api.hyperliquid-testnet.xyz, mainnet → https://api.hyperliquid.xyz
NEXT_PUBLIC_HL_NETWORK=testnet
# Builder address that receives the builder fee on every order (required to trade).
NEXT_PUBLIC_HL_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Fee charged per order, in tenths of a basis point (10 = 1 bp = 0.01%). Perps allow at most 100.
NEXT_PUBLIC_HL_BUILDER_FEE=10
# Max fee users approve once during setup, same unit. Must be >= NEXT_PUBLIC_HL_BUILDER_FEE.
NEXT_PUBLIC_HL_MAX_BUILDER_FEE=10
# HIP-3 dexes to list (comma-separated). xyz hosts the equity perps (NVDA, TSLA, ...); testnet has hundreds of others.
NEXT_PUBLIC_HL_HIP3_DEXES=xyz

# Lighter venue (public: these reach the browser). Switch networks with config only.
# testnet → https://testnet.zklighter.elliot.ai (chain 300), mainnet → https://mainnet.zklighter.elliot.ai (chain 304)
NEXT_PUBLIC_LIGHTER_NETWORK=testnet
# API key slot the terminal registers its browser key at (4-254; 0-3 belong to Lighter's apps). Default 61.
NEXT_PUBLIC_LIGHTER_API_KEY_INDEX=
# Optional partner attribution: integrator account index and fees in millionths of trade size (1000 = 10 bps).
# Non-zero fees only apply to Plus/Premium users; Standard users approve zero fees. Leave empty to disable.
NEXT_PUBLIC_LIGHTER_INTEGRATOR_ACCOUNT=
NEXT_PUBLIC_LIGHTER_INTEGRATOR_FEE=0
NEXT_PUBLIC_LIGHTER_MAX_INTEGRATOR_FEE=0
# Optional Lighter referral code (create it on app.lighter.xyz with the integrator account). Offered as an opt-in
# checkbox in the "Approve Angler" setup step; Lighter replaces any code the user's account already uses.
NEXT_PUBLIC_LIGHTER_REFERRAL_CODE=

# Lighter on Robinhood Chain ("Lighter RH"): a separate Lighter exchange (USDG margin, mostly stock perps).
# testnet → https://api.rh-testnet.lighter.xyz (chain 300), mainnet → https://api.rh.lighter.xyz (chain 466324).
# Pinned to the deployment like the other venues. Its integrator account is an account index on the RH exchange
# (open it with a USDG deposit on Robinhood Chain); fees in millionths of trade size, as above (max 10000 = 1%).
NEXT_PUBLIC_LIGHTER_RH_NETWORK=testnet
NEXT_PUBLIC_LIGHTER_RH_INTEGRATOR_ACCOUNT=
NEXT_PUBLIC_LIGHTER_RH_INTEGRATOR_FEE=0
NEXT_PUBLIC_LIGHTER_RH_MAX_INTEGRATOR_FEE=0
NEXT_PUBLIC_LIGHTER_RH_REFERRAL_CODE=

# Jupiter Swap V2 (server only, never NEXT_PUBLIC_). Get a key at https://developers.jup.ag/portal
JUP_API_KEY=your-jupiter-api-key
# Referral account from https://referral.jup.ag and fee in bps (Jupiter accepts 50-255). Leave both empty to disable.
JUP_REFERRAL_ACCOUNT=
JUP_REFERRAL_FEE_BPS=50
# Solana RPC used server-side for wallet balances. Use a private RPC in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional USD size presets for the spot panel (development defaults to 1,2,5).
NEXT_PUBLIC_SPOT_SIZE_PRESETS=
# Optional USD presets for perp trades (development defaults to 10,25,50; Hyperliquid's minimum is $10).
NEXT_PUBLIC_PERP_SIZE_PRESETS=

# Titan (server only): Solana spot quotes compared with Jupiter on every swap. Key from https://developer.titan.exchange
# (free Sandbox plan: 1 request/second). Leave empty to use Jupiter alone.
TITAN_API_KEY=
# Optional Titan partner fee, always collected in USDC: the Solana wallet that receives it (its USDC token account
# must exist, i.e. the wallet has held USDC once) and the rate in bps (1-255). Leave empty for no fee.
TITAN_FEE_WALLET=
TITAN_FEE_BPS=

# Arcus spot (stock tokens on Robinhood Chain). testnet (default) or mainnet; no key needed to trade.
NEXT_PUBLIC_ARCUS_NETWORK=testnet
# Optional Robinhood Chain RPC (defaults to the public, rate-limited rpc.mainnet / rpc.testnet.chain.robinhood.com).
NEXT_PUBLIC_ARCUS_RPC_URL=
# Optional partner key from Arcus (server only) and builder fee in bps; the fee only applies with a key.
ARCUS_API_KEY=
ARCUS_BUILDER_FEE_BPS=

# Optional CoinGecko key for /spot token charts (each token's own DEX pool candles). Without it the free GeckoTerminal
# API is used (about 10 calls a minute for the whole site, cached across visitors, no credits).
# COINGECKO_API_PLAN: "pro" for paid plans (Basic and up, pro-api.coingecko.com), "demo" for the free demo key.
# COINGECKO_DAILY_BUDGET caps the terminal's calls per UTC day (default 2500), so a key shared with another app keeps
# credits for it; past the cap the chart shows the asset's market chart until the next day.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=pro
COINGECKO_DAILY_BUDGET=2500

# Bearer token for GET /api/analytics/trade (daily totals: trades, USD volume, estimated fees; no personal data).
ANALYTICS_TOKEN=change-me
# Redis for the analytics totals (Upstash REST; Vercel's Upstash integration sets these two). Without them totals
# live in memory per server instance and reset on restart. UPSTASH_REDIS_REST_URL/TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Polymarket trading on /prediction (data needs nothing). Create a builder profile at polymarket.com → Settings →
# Builders: the builder code (bytes32, public, attached to every order) and an API key + secret + passphrase (server
# only; they sign the user's gasless wallet setup and orders through /api/prediction/polymarket/sign). Without the
# code the page shows Polymarket odds, charts and books but no trade button. Set your fee rates on the builder profile.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Across (funds window: USDC on Arbitrum/Base <-> USDG on Robinhood Chain). Server only, all optional.
# ACROSS_INTEGRATOR_ID is the 2-byte hex id Across assigns (0x....); the app fee is a fraction (0.001 = 0.1%, max 0.01).
ACROSS_INTEGRATOR_ID=
ACROSS_APP_FEE=
ACROSS_APP_FEE_RECIPIENT=

# Uniswap Trading API (developers.uniswap.org dashboard; mainnet only, no testnet). Server only, never NEXT_PUBLIC_.
# With a key, Robinhood Chain stock swaps quote Uniswap next to Arcus and take the better price. The fee is in bps
# (max 500, two decimals at most) paid in the output token to UNISWAP_FEE_RECIPIENT (an EVM address you control).
UNISWAP_API_KEY=
UNISWAP_FEE_BPS=
UNISWAP_FEE_RECIPIENT=

# Relay (relay.link): second bridge route next to Across, and cross-chain swaps of any token. Works without a key.
# RELAY_FEE_BPS is our app fee in whole bps of the input (max 500), accrued to RELAY_FEE_RECIPIENT (an EVM address
# you control; claim in Relay's app). RELAY_API_KEY is optional (higher rate limits, our referrer name on quotes).
RELAY_FEE_BPS=
RELAY_FEE_RECIPIENT=
RELAY_API_KEY=
